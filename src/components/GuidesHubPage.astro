---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CANONICAL_ORIGIN } from '../config/site';
import LangToggle from './LangToggle.astro';
import SocialLinks from './SocialLinks.astro';
import Footer from './Footer.astro';
import ClaudeNews from './ClaudeNews.astro';
import OfficialRules from './OfficialRules.astro';
import GuideCatalog from './GuideCatalog.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'zh' ? '/zh' : '';
const home = `${prefix}/`;
const newsHub = `${prefix}/news/`;
const guidesHub = `${prefix}/guides/`;
const extensionPage = `${prefix}/extension/`;

const readingPaths = [
  { slug: 'antiban-essentials', key: 'path0' },
  { slug: 'claude-steganography-and-risk-model', key: 'path1' },
  { slug: 'environment-cleanup-and-ip-setup', key: 'path2' },
  { slug: 'account-registration-and-payment-antiban', key: 'path3' },
  { slug: 'claude-code-and-api-safety', key: 'path4' },
  { slug: 'account-appeal-and-recovery-sop', key: 'path5' },
];

const site = Astro.site ?? new URL(CANONICAL_ORIGIN);
const currentUrl = new URL(guidesHub, site).href;
const homeUrl = new URL(home, site).href;

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('nav.home'),
      item: homeUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('nav.guides'),
      item: currentUrl,
    },
  ],
};
---

<BaseLayout
  lang={lang}
  path={guidesHub}
  title={`${t('guides.title')} | Claude Check`}
  description={t('guides.sub')}
  enPath="/guides/"
  zhPath="/zh/guides/"
  omitFaq
  jsonLdExtra={breadcrumbJsonLd}
>
  <header class="nav">
    <div class="wrap nav__inner">
      <a class="brand" href={home}>
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="currentColor"></rect>
          <g fill="#FAF9F5" transform="translate(56 10) scale(-2 2)">
            <path d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"></path>
          </g>
        </svg>
        <span class="brand__text">{t('nav.title')}</span>
      </a>
      <nav class="nav__actions">
        <a class="nav__link" href={home}>{t('nav.home')}</a>
        <a class="nav__link" href={guidesHub} aria-current="page">{t('nav.guides')}</a>
        <a class="nav__link" href={newsHub}>{t('nav.news')}</a>
        <a class="nav__link" href={extensionPage}>{t('nav.extension')}</a>
        <LangToggle lang={lang} />
        <SocialLinks lang={lang} />
      </nav>
    </div>
  </header>

  <main class="wrap hub" data-lang={lang}>
    <section class="guides-hero">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={home}>{t('nav.home')}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{t('nav.guides')}</li>
        </ol>
      </nav>
      <h1>{t('guides.title')}</h1>
      <p class="guides-sub">{t('guides.sub')}</p>
      <p class="guides-intro">{t('guides.intro')}</p>
      <p class="guides-editorial">{t('guides.editorial')}</p>
    </section>

    <OfficialRules lang={lang} />

    <section class="reading-paths" aria-labelledby="paths-title">
      <div class="paths-head">
        <h2 id="paths-title">{t('guides.paths.title')}</h2>
        <p>{t('guides.paths.sub')}</p>
      </div>
      <div class="paths-grid">
        {
          readingPaths.map((p) => (
            <a class="path-card" href={`${guidesHub}${p.slug}/`}>
              <h3>{t(`guides.${p.key}.title`)}</h3>
              <p>{t(`guides.${p.key}.desc`)}</p>
              <span class="path-card__cta">{t(`guides.${p.key}.cta`)} →</span>
            </a>
          ))
        }
      </div>
    </section>

    <GuideCatalog lang={lang} />

    <section class="news-section">
      <ClaudeNews
        lang={lang}
        limit={3}
        categories={['policy', 'security']}
        title={t('guides.news.title')}
        sub={t('guides.news.sub')}
        showMoreLink
      />
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .guides-hero {
    padding: 36px 0 20px;
  }
  .breadcrumb {
    margin-bottom: 12px;
    font-size: 0.86rem;
  }
  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--muted-2);
  }
  .breadcrumb a {
    color: var(--muted);
    font-weight: 600;
  }
  .breadcrumb a:hover {
    color: var(--accent-strong);
  }
  .guides-hero h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .guides-sub {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 65ch;
    margin: 0;
  }
  .guides-intro {
    font-size: 0.98rem;
    color: var(--muted);
    max-width: 70ch;
    margin: 16px 0 0;
    line-height: 1.65;
  }
  .guides-editorial {
    font-size: 0.92rem;
    color: var(--muted-2);
    max-width: 65ch;
    margin: 12px 0 0;
    line-height: 1.55;
  }
  .hub[data-lang='zh'] .guides-intro {
    line-height: 1.75;
  }
  .hub[data-lang='zh'] .guides-editorial {
    line-height: 1.65;
  }
  .reading-paths {
    padding: 16px 0 4px;
  }
  .paths-head h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    margin: 0 0 4px;
  }
  .paths-head p {
    font-size: 0.95rem;
    color: var(--muted);
    margin: 0 0 16px;
  }
  .paths-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: 14px;
  }
  .news-section {
    padding: 8px 0 40px;
  }
  .path-card {
    display: flex;
    flex-direction: column;
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    color: var(--text);
    overflow-wrap: anywhere;
    transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s;
  }
  .path-card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: var(--shadow-md);
  }
  .path-card h3 {
    font-size: 1rem;
    margin: 0 0 8px;
    line-height: 1.4;
    color: var(--text);
  }
  .path-card:hover h3 {
    color: var(--accent-strong);
  }
  .path-card p {
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0 0 14px;
    flex: 1;
  }
  .hub[data-lang='zh'] .path-card p {
    line-height: 1.65;
  }
  .path-card__cta {
    font-size: 0.82rem;
    font-weight: 650;
    color: var(--accent-strong);
  }
</style>
