---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CANONICAL_ORIGIN } from '../../../config/site';
import LangToggle from '../../../components/LangToggle.astro';
import SocialLinks from '../../../components/SocialLinks.astro';
import Footer from '../../../components/Footer.astro';
import ClaudeNews from '../../../components/ClaudeNews.astro';
import CommunityPosts from '../../../components/CommunityPosts.astro';
import { useTranslations } from '../../../i18n/ui';

const lang = 'zh';
const t = useTranslations(lang);
const home = '/zh/';
const guidesHub = '/zh/guides/';
const newsHub = '/zh/news/';
const extensionPage = '/zh/extension/';

const site = Astro.site ?? new URL(CANONICAL_ORIGIN);
const currentUrl = new URL(newsHub, site).href;
const homeUrl = new URL(home, site).href;

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('nav.home'),
      item: homeUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('news.title'),
      item: currentUrl,
    },
  ],
};
---

<BaseLayout
  lang={lang}
  path="/zh/news/"
  title={`${t('news.title')} | Claude Check`}
  description={t('news.sub')}
  enPath="/news/"
  zhPath="/zh/news/"
  omitFaq
  jsonLdExtra={breadcrumbJsonLd}
>
  <header class="nav">
    <div class="wrap nav__inner">
      <a class="brand" href={home}>
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="currentColor"></rect>
          <g fill="#FAF9F5" transform="translate(56 10) scale(-2 2)">
            <path d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"></path>
          </g>
        </svg>
        <span class="brand__text">{t('nav.title')}</span>
      </a>
      <nav class="nav__actions">
        <a class="nav__link" href={home}>{t('nav.home')}</a>
        <a class="nav__link" href={guidesHub}>{t('nav.guides')}</a>
        <a class="nav__link" href={newsHub} aria-current="page">{t('nav.news')}</a>
        <a class="nav__link" href={extensionPage}>{t('nav.extension')}</a>
        <LangToggle lang={lang} />
        <SocialLinks lang={lang} />
      </nav>
    </div>
  </header>

  <main class="wrap">
    <section class="news-hero">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={home}>{t('nav.home')}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{t('news.title')}</li>
        </ol>
      </nav>

      <h1>{t('news.title')}</h1>
      <p class="news-sub">{t('news.sub')}</p>
      <p class="news-note">{t('news.note')}</p>
    </section>

    <ClaudeNews lang={lang} />

    <div id="community-posts" style="scroll-margin-top: 80px;">
      <CommunityPosts lang={lang} />
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .news-hero {
    padding: 36px 0 16px;
  }
  .breadcrumb {
    margin-bottom: 12px;
    font-size: 0.86rem;
  }
  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--muted-2);
  }
  .breadcrumb a {
    color: var(--muted);
    font-weight: 600;
  }
  .breadcrumb a:hover {
    color: var(--accent-strong);
  }
  .news-hero h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .news-sub {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 65ch;
    margin: 0;
  }
  .news-note {
    font-size: 0.88rem;
    color: var(--muted-2);
    max-width: 65ch;
    margin: 12px 0 0;
    line-height: 1.55;
  }
</style>
